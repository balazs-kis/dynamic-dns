<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for Microsoft.Testing.Extensions.CodeCoverage (passed via the coverage-settings option in CI). -->
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <!-- Source-generated code (e.g. System.Text.Json serializer context) lives under obj/ -->
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
